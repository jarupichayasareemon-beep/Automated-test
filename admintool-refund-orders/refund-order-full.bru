meta {
  name: Admintool Refund Order Full
  type: http
  seq: 1
}

post {
  url: {{base_url}}/v1/admintool/order/{{order_id}}/refund/full
  body: json
  auth: none
}

body:json {
  {
    "collectionFee": false,
    "donation": false,
    "installment": false,
    "passOn": true,
    "paymentGateWayFee": false,
    "refundProtect": false,
    "shipping": false,
    "voucher": false,
    "type": "refund"
  }
}
