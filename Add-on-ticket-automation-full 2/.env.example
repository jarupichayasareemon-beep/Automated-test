# ---- Event admin (web UI) ----
# ตัวอย่างจริง (Ticketmelon): BASE_URL=https://premanager.ticketmelon.com
# แล้ว ORGANIZER_ID / EVENT_ID มาจาก URL ตอนแก้ event ด้วยมือ เช่น
# https://premanager.ticketmelon.com/organizer/<ORGANIZER_ID>/event/<EVENT_ID>/overview/summary/
BASE_URL=https://your-event-admin.example.com
ADMIN_USERNAME=your_admin_user
ADMIN_PASSWORD=your_admin_password
ORGANIZER_ID=your_organizer_id
EVENT_ID=EVT-2026-001

# ชื่อ/ราคาที่จะใช้กรอกฟอร์มตอนสร้าง ticket (แก้ตามระบบจริง)
MAIN_TICKET_NAME=General Admission
MAIN_TICKET_PRICE=500
ADDON_TICKET_NAME=Parking Add-on
ADDON_TICKET_PRICE=100

# รันแบบเห็นหน้าจอ (false) หรือ headless (true) — ตอน debug selector ให้ตั้ง false ก่อน
HEADLESS=false

# ไฟล์เก็บ session หลัง login (auto สร้างให้เอง ไม่ต้องสร้างมือ) — อย่า commit ไฟล์นี้ขึ้น git
STORAGE_STATE_PATH=storage_state.json

# ---- AWS / DynamoDB ----
# table event (key: event_id) -> ใส่ is_add_on = true
# table ticket type (key: ticket_type_id) -> addon ticket ใส่ type="add-on",
#   main ticket ใส่ add_on={condition, is_active, ticket_type: {<addon_id>: {conditions:{min,max}}}}
AWS_REGION=ap-southeast-1
AWS_PROFILE=default
DYNAMODB_TABLE=events_v1
DYNAMODB_PARTITION_KEY=event_id
DYNAMODB_TICKET_TYPE_TABLE=ticket_type_v1
DYNAMODB_TICKET_TYPE_PARTITION_KEY=ticket_type_id
ADDON_CONDITION=one_ticket_one_item
ADDON_MIN_QTY=1
ADDON_MAX_QTY=3

# DYNAMODB_METHOD=console -> คลิกผ่าน AWS Console ด้วย Playwright (ไม่ต้องมี IAM access key)
# DYNAMODB_METHOD=boto3   -> ใช้ AWS SDK ตรงๆ ผ่าน Access Key/Secret (aws configure)
DYNAMODB_METHOD=console
AWS_CONSOLE_BASE_URL=https://ap-southeast-1.console.aws.amazon.com
# copy ลิงก์เต็มๆ ที่คุณกดด้วยมือแล้ว login ได้จริง (เปิด DevTools ดู URL ตอนอยู่หน้า sign-in
# หรือลิงก์ที่ bookmark ไว้ใช้ประจำ) วางทั้งบรรทัดตรงนี้
AWS_CONSOLE_LOGIN_URL=
# ใส่บัญชี AWS ที่ใช้สำหรับ automation นี้ (บัญชีกลางของทีม หรือของตัวเอง)
AWS_CONSOLE_ACCOUNT_ALIAS=your_account_alias
AWS_CONSOLE_USERNAME=your_iam_username
AWS_CONSOLE_PASSWORD=your_password
AWS_CONSOLE_STORAGE_STATE_PATH=aws_console_storage_state.json
