# Copy this file to .env and fill in real values. .env is gitignored.

BASE_URL=https://dev.ticketmelon.com

# Used by login() in tests/helpers/auth.ts (dev-env sign-in page).
# Leave both blank and use storageState.json instead if you'd rather not put
# credentials in an env file (see README "Authentication").
TEST_EMAIL=
TEST_PASSWORD=

# Second account with zero saved cards — used only by the "empty state" block
# in Test case/Localize saved card/Localize-saved-card.spec.ts to cover the
# "You haven't saved any cards yet." empty state, which the main TEST_EMAIL
# account can't show (it always has cards on it). This account has 2FA (it's
# the same account as TEST_PROMO_EMAIL below), so TEST_PROMO_TOTP_SECRET must
# also be set for it to log in.
TEST_EMPTY_EMAIL=
TEST_EMPTY_PASSWORD=

# Regression event, used for the test cases in
# "[Product] Test Cases for Regression automated - Normal_ All Condition.csv".
# This event charges real money — payment-flow tests stop at the OTP page
# and never submit the OTP.
TESTPROD_EVENT_URL=https://www.ticketmelon.com/qamtel/cca7ee64f13411f0923401117567899b

# Real card used only to reach the OTP page in payment-flow tests (TC_044-055).
# Never commit real values — this file only documents the expected shape.
TEST_CARD_NUMBER=
TEST_CARD_EXPIRY=
TEST_CARD_CVV=
TEST_CARD_NAME=

# Account the qamtel promo codes are eligible under — has 2FA. See
# scripts/save-promo-account-session.js: run it locally (needs a real
# display for the 2FA step), it saves a reusable session to
# storageState-promo.json.
TEST_PROMO_EMAIL=
TEST_PROMO_PASSWORD=

# TOTP secret key for the 2FA on TEST_PROMO_EMAIL / TEST_EMPTY_EMAIL (same
# account). Required in CI (no human to type the OTP code) — must also be set
# as a GitHub Actions repo secret of the same name.
TEST_PROMO_TOTP_SECRET=
